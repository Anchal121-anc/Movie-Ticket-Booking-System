@startuml
actor Customer
participant BookingService
participant Show
participant ShowSeat
participant PriceCalculator
participant Payment
participant Booking
participant TicketPrinter

Customer -> BookingService : chooseShow(movie, show)
activate BookingService
BookingService -> Show : findShowSeat(1)
activate Show
Show --> BookingService : ShowSeat*
deactivate Show

BookingService -> ShowSeat : isAvailable()
activate ShowSeat
ShowSeat --> BookingService : true
deactivate ShowSeat

BookingService -> PriceCalculator : calculate([ShowSeat])
activate PriceCalculator
PriceCalculator --> BookingService : total = ₹150
deactivate PriceCalculator

BookingService -> ShowSeat : bookSeat()
activate ShowSeat
ShowSeat --> BookingService : true
deactivate ShowSeat

create Booking
BookingService -> Booking : <<create>>(customer, show, [1], ₹150)
activate Booking
Booking --> BookingService : pending booking
deactivate Booking

create Payment
BookingService -> Payment : <<create>> UpiPayment
activate Payment
Payment --> BookingService : Payment*
deactivate Payment

BookingService -> Payment : pay(₹150)
activate Payment
Payment --> BookingService : true
deactivate Payment

BookingService -> Booking : confirm()
activate Booking
Booking --> BookingService : confirmed
deactivate Booking

BookingService -> TicketPrinter : print(Booking, Payment)
activate TicketPrinter
TicketPrinter --> Customer : Ticket printed
deactivate TicketPrinter
deactivate BookingService

alt Payment fails
  Payment --> BookingService : false
  BookingService -> ShowSeat : cancelSeat()
  ShowSeat --> BookingService : AVAILABLE
  BookingService --> Customer : Booking NOT confirmed
end
@enduml
